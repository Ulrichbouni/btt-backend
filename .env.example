# ===== BTT-LUX Backend — Exemple de variables d'environnement =====
# Copiez ce fichier vers .env et remplissez les vraies valeurs.
# Ne COMMITTEZ JAMAIS le vrai .env (il est ignoré par .gitignore).

# Serveur
PORT=5000
NODE_ENV=production

# Base de données PostgreSQL (Render / Neon / Supabase…)
# Exemple Render : postgres://user:pass@host:5432/btt_lux?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/btt_lux?sslmode=require

# Sécurité — VALUEURALE PLACEHOLDER : en production, le serveur refuse ce texte.
# Générez une valeur aléatoire d'au moins 32 caractères (64 caractères hex).
# PowerShell : [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Origine autorisée pour le CORS (URL exacte du frontend, sans slash final)
FRONTEND_URL=https://votre-frontend.vercel.app

# Téléphone / WhatsApp (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Paiement mobile money (Campay)
CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_ACCESS_TOKEN=
CAMPAY_WEBHOOK_KEY=
CAMPAY_SANDBOX=true

# Assistant IA (OpenRouter)
OPENROUTER_API_KEY=

# Emails transactionnels (OTP, bienvenue, reset, devis)
# EMAIL_PROVIDER=gmail | brevo | resend
EMAIL_PROVIDER=gmail
# Gmail SMTP (gratuit, quota ~500/jour) : mot de passe d'application 16 car.
MAIL_USER=
MAIL_APP_PASS=
MAIL_FROM_NAME=BTT-LUX
# Brevo (SMTP relay smtp-relay.brevo.com:587, ~300/jour gratuit)
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
# Resend (API HTTP, ~3000/mois gratuit, meilleure délivrabilité)
# RESEND_API_KEY=
# Adresse d'expédition (obligatoire pour Resend : domaine vérifié)
# EMAIL_FROM="BTT-LUX <notifications@votre-domaine.com>"
# Garde-fou quota journalier global, tous emails confondus (défaut 450 < 500 Gmail)
EMAIL_DAILY_MAX=450
# Stockage OTP email : 'sql' (prod, table email_otp_codes) ou 'memory' (tests/dev)
# Par défaut : SQL en production, mémoire hors production.
# OTP_STORE=sql
# Purge autonome pour cron/scheduler (recommandée toutes les 5 à 15 min) :
# npm run db:purge-otp
# Le serveur purge également les entrées expirées toutes les 5 min.
# DEV UNIQUEMENT : expose GET /api/auth/debug-otp-email (jamais en prod)
# ALLOW_OTP_DEBUG=true

# Seed initial (aucune valeur par défaut => seed refusé si absent)
# ADMIN_PASSWORD doit faire au moins 12 caractères.
ADMIN_EMAIL=admin@btt-lux.com
ADMIN_PASSWORD=